# Copy this file to .env in backend/ (it is gitignored; never commit real values).

# Supabase Postgres (transaction pooler)
SUPABASE_PROJECT_REF=
SUPABASE_PASSWORD=
SUPABASE_POOLER_HOST=

# The chat model, speech-to-text and the flood photo and video check
MUSE_API=

# Tomorrow.io weather forecast (fetched once a day and stored in Supabase)
TOMMORROW_IO_API=

# Google sign-in. REQUIRE_AUTH=true (the default) makes the assistant chat, photo check and voice need a Supabase
# access token; the backend finds your project from SUPABASE_PROJECT_REF (or set SUPABASE_URL). Use false for local work.
REQUIRE_AUTH=false

# Redis cache and shared rate limits (optional; without it nothing is cached and limits are counted in memory)
REDIS_URL=

# Downloads the embedding model in scripts/ingest_corpus.py
HF_TOKEN=

# LangSmith tracing
LANGSMITH_KEY=
LANGSMITH_TRACE=true
LANGSMITH_PROJECT=flood-gentic
