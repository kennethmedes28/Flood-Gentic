# Copy this file to .env.local (it is gitignored; never commit real values).
# Only variables that start with NEXT_PUBLIC_ reach the browser, so never put a secret in one.

# Where the backend (FastAPI) is. The dashboard, the assistant, the live weather and the photo and video checks all call it.
# `make run` (or hooks/run_all.sh) sets this for you when it starts both programs.
NEXT_PUBLIC_API_URL=http://localhost:8000
